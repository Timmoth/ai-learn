{
  "active_backend": "claude-code",
  "backends": {
    "claude-code": {
      "command": "claude",
      "args": [
        "-p", "{prompt}",
        "--permission-mode", "acceptEdits",
        "--allowedTools", "WebSearch,WebFetch,Read,Write,Edit,Bash"
      ],
      "verbose_args": ["--verbose"],
      "prompt_via": "arg"
    },
    "opencode": {
      "command": "opencode",
      "args": ["run", "{prompt}"],
      "verbose_args": [],
      "prompt_via": "arg"
    }
  },
  "tts": {
    "enabled": true,
    "url": "http://10.0.50.4:8880/v1",
    "model": "kokoro",

    "voice": "am_eric",
    "speed": 0.90,
    "response_format": "wav",

    "normalization_options": {
      "normalize": false,
      "unit_normalization": false,
      "url_normalization": false,
      "email_normalization": false,
      "optional_pluralization_normalization": false,
      "phone_normalization": false,
      "replace_remaining_symbols": true
    },

    "preprocess": {
      "apply_dictionary": true,
      "dictionary_mode": "word_boundary",
      "dictionary_longest_first": true,
      "spell_acronyms_with_spaces": true,
      "debug_tts_input": true
    },

    "timeout_seconds": 600
  },
  "site": {
    "title": "ai-learn",
    "description": "AI-generated learning material with written lessons and accompanying audio narration.",
    "url": "https://ai-learn.timmoth.com",
    "author": "Tim Jones",
    "author_url": "https://timmoth.com",
    "github_url": "https://github.com/Timmoth/ai-learn"
  }
}
